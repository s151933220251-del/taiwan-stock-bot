# 複製成 .env 後填入（.env 已列入 .gitignore，絕對不要 commit）
FUBON_ID=A123456789
FUBON_PASSWORD=你的登入密碼
FUBON_CERT_PATH=/path/to/你的憑證.pfx
FUBON_CERT_PASSWORD=憑證密碼
# 有多個證券帳號時才需要填
FUBON_ACCOUNT_NO=

# 交易通知（沿用日報的 LINE Bot）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# 選填，提高 FinMind 歷史資料額度
FINMIND_TOKEN=

# 只有設成 live 並加上 --live 才會真的下單
TRADING_MODE=paper
